--# TEMPLATE for scripts/set_up_book_labels.py (skill set-up-book-labels) - rendered only when some of the
--# branch's book labels, or its dummy label, do not exist in the target (Q-10f). The operator reviews and
--# runs the file; no agent does. ASCII only.
SET DEFINE OFF
-- ============================================================================
-- {{BRANCH_CODE}} - BOX book labels - {{TARGET_ENV}}
-- PROPOSAL: create {{N}} BOX label(s). TO REVIEW AND RUN (operator, an account that can write PGT_SYS).
-- Rendered by scripts/set_up_book_labels.py from books/00-books.csv and books/book-labels.json.
-- Do not edit: change the inputs and run the script again.
--
-- Why: FE step 11 (branch x instrument x book, plus the dummy) and every batch job run by label, and
-- these labels do not exist in this environment yet (Q-10f; {{N_FOUND}} book label(s) already exist).
-- Rules (04-add-book-procedure.md 2.4): {{TABLE}}, FK_OWNER_OBJ = {{OWNER_OBJ}}; CODE = X + country code
-- + 01..; DESCRIPTION = the data-lake book label, exactly; PK {{PK_RULE}} (decision {{DECISIONS}}).
-- Each insert is followed by PGT_SYS.Pkg_SysPrecommit.p_DomainsPreCommit(PK), as the screen does on save (Q-10g).
-- If that pre-commit commits by itself, the rows are committed when it returns - check before running in PROD.
-- Run with an account that can write {{TABLE}}. It stops, inserting nothing, if any code, description
-- or PK already exists. It does NOT commit: check the rows it lists, then commit them yourself.
-- Afterwards: the operator re-runs Q-10f, saves it in books/01-evidence/, and runs the script again.
-- ============================================================================
SET SERVEROUTPUT ON SIZE UNLIMITED
ALTER SESSION SET NLS_NUMERIC_CHARACTERS = '.,';
DECLARE
  v_n NUMBER;
{{DECLS}}
BEGIN
  SELECT COUNT(*) INTO v_n FROM {{TABLE}}
  WHERE  FK_OWNER_OBJ = {{OWNER_OBJ}}
  AND   (CODE IN ({{CODES}})
      OR DESCRIPTION IN ({{DESCS}}));
  IF v_n > 0 THEN
    RAISE_APPLICATION_ERROR(-20001, 'LABELS STOPPED - ' || v_n || ' of these labels already exist. Nothing inserted: re-run Q-10f and the script.');
  END IF;
{{PK_GUARD}}
{{INSERTS}}
  DBMS_OUTPUT.PUT_LINE('LABELS READY - {{N}} label(s) inserted, NOT committed. Check the rows listed below, then commit them yourself.');
END;
/
SELECT PK, CODE, DESCRIPTION FROM {{TABLE}}
WHERE  FK_OWNER_OBJ = {{OWNER_OBJ}} AND CODE IN ({{CODES}})
ORDER  BY CODE;
