-- ============================================================================
-- {{BRANCH_CODE}} — BOX FE configuration — {{TARGET_ENV}}                 CONFIG  (1 of 3)
-- Generated by sigom-box-fe-configs-agent, run {{RUN_NO}}, {{RUN_DATE}}. Evidence: 01-evidence/
-- Run order : this file  →  {{BRANCH_CODE}}-{{ENV}}-verify.sql  →  (only to undo) -rollback.sql
-- ⚠ COMMITS : PKG_ENGPRECOMMIT.p_check_Val_Curves_precommit at the end of this file commits the
--             whole transaction. The undo is the rollback file, never a ROLLBACK statement.
--
-- TEMPLATE — every double-brace placeholder is replaced by the run with the recorded value AND its
-- source in a trailing comment. A generated file with any placeholder left is not finished (the
-- validator FAILs it). Delete these template notes from the generated file.
-- Two kinds of source, never mixed:
--   * sets MINED from GBO (step 4 quote refs, step 7 exceptions) are READ IN-SCRIPT and count-guarded
--   * values DECIDED or SIGNED by a person (steps 2 sources, 6, 11, 12, 14a) are literals, with provenance
-- ============================================================================
SET DEFINE OFF
SET SERVEROUTPUT ON
DECLARE
  -- environment (Q-G3c, recorded in 00-inputs.md)
  c_expected_auth_code  CONSTANT NUMBER := {{TARGET_AUTH_CODE}};
  v_auth_code           NUMBER;
  v_fraction            NUMBER;

  -- identity per destination table (Q-G6 / Q-G7 derivation — never sampled from rows)
  c_owner_conf          CONSTANT NUMBER := {{OWNER_ENGCONF}};        -- BOX_ENG_Config
  c_ext_conf_x          CONSTANT NUMBER := {{EXT_ENGCONF_X}};        -- apBranch
  c_ext_accrconf        CONSTANT NUMBER := {{EXT_ENGACCRCONF}};      -- amAccrualConfig
  c_ext_config_accrual  CONSTANT NUMBER := {{EXT_CONFIG_ACCRUAL}};   -- BOX_ENG_Config_Accrual
  c_ext_conf_by_book    CONSTANT NUMBER := {{EXT_CONF_BY_BOOK}};     -- amConfigByBook
  c_owner_fcurve        CONSTANT NUMBER := {{OWNER_ENGFCURVE}};      -- BOX_ENG_FixingCurve
  c_ext_englkfc         CONSTANT NUMBER := {{EXT_ENGLKFC}};          -- apQuoteReference
  c_owner_errors        CONSTANT NUMBER := {{OWNER_ERRORS_FE}};      -- BOX - Limit Error Assign (no extension)
  c_owner_days_matured  CONSTANT NUMBER := {{OWNER_DAYS_MATURED}};   -- BOX_ENG_Days_Matured (no extension)

  -- references (reference FKs and stated constants — hard rule 13)
  c_branch_pk           CONSTANT NUMBER := {{BRANCH_PK}};            -- Q-G1
  c_source_front        CONSTANT NUMBER := {{SOURCE_FRONT}};         -- input SOURCE_FRONT (Murex instance), Q-02c
  c_source_back         CONSTANT NUMBER := 586.4;                    -- BOX is always the back source [stated 2026-09-23]
  c_dummy_book          CONSTANT NUMBER := {{DUMMY_BOOK_LABEL}};     -- input DUMMY_BOOK_LABEL, Q-10c

  -- source filters: read from DEVENG, NEVER written to a BOX column
  c_gbo_config_pk       CONSTANT NUMBER := {{GBO_CONFIG_PK}};        -- Q-G2
  c_gbo_curve_pk        CONSTANT NUMBER := {{GBO_CURVE_PK}};         -- Q-03
  c_expected_quote_refs CONSTANT PLS_INTEGER := {{EXPECTED_QUOTE_REFS}};  -- Q-04c (b)
  c_expected_exceptions CONSTANT PLS_INTEGER := {{EXPECTED_EXCEPTIONS}};  -- Q-06, after both filters

  v_conf_pk   NUMBER;
  v_curve_pk  NUMBER;
  v_pk        NUMBER;
  v_n         PLS_INTEGER;

  -- every allocated PK must carry this environment's auth-code fraction
  PROCEDURE chk_pk (p_pk NUMBER, p_table VARCHAR2) IS
  BEGIN
    IF p_pk IS NULL OR p_pk - TRUNC(p_pk) <> v_fraction THEN
      RAISE_APPLICATION_ERROR(-20001, p_table || ': PK ' || p_pk ||
        ' does not carry the auth-code fraction ' || v_fraction);
    END IF;
  END;
BEGIN
  -- ==========================================================================
  -- STEP 0 — Environment and auth code                   →  gom_glb_sys.t__CORE_INFO_S
  -- What        : stop before the first INSERT if this is not the environment the run was built for
  -- Source      : Q-G3c — auth code {{TARGET_AUTH_CODE}}, fraction {{TARGET_PK_FRACTION}}
  -- If wrong    : every PK carries another environment's suffix — rows that look right and are not
  -- ==========================================================================
  SELECT auth_code INTO v_auth_code FROM gom_glb_sys.t__CORE_INFO_S;
  IF v_auth_code <> c_expected_auth_code THEN
    RAISE_APPLICATION_ERROR(-20000, 'Wrong environment: auth code ' || v_auth_code ||
      ', this script was generated for ' || c_expected_auth_code);
  END IF;
  v_fraction := v_auth_code / POWER(10, LENGTH(TO_CHAR(v_auth_code)));
  DBMS_OUTPUT.PUT_LINE('Auth code ' || v_auth_code || ' -> every PK ends in ' || v_fraction);

  -- ==========================================================================
  -- STEP 2 — MIS configuration header                    →  BOX_FE.T_BOX_ENGCONF_S
  -- What        : the configuration. 1 row. Points at the curve step 3 creates — its PK is allocated here,
  --               because FK_CURVEMAN/FK_CURVEACC are NOT NULL (no NULL-then-UPDATE: ORA-01400)
  -- Source      : DESCRIPTION, FK_CALENDAR, FK_CURRENCY mined from DEVENG.T_PGT_ENGCONF_S {{GBO_CONFIG_PK}} (Q-02)
  --               FK_SOURCE_FRONT = SOURCE_FRONT (input) · FK_SOURCE_BACK = 586.4 (constant) — NOT mined
  -- Findings    : row 2, {{STATUS_2}}
  -- If wrong    : the batch reads the wrong sources or calendar for every deal of the branch
  -- ==========================================================================
  v_conf_pk  := F___SEQUENCE('T_BOX_ENGCONF_S','X');    chk_pk(v_conf_pk,  'T_BOX_ENGCONF_S');
  v_curve_pk := F___SEQUENCE('T_BOX_ENGFCURVE_S','X');  chk_pk(v_curve_pk, 'T_BOX_ENGFCURVE_S');
  INSERT INTO BOX_FE.T_BOX_ENGCONF_S
    (PK, FK_OWNER_OBJ, DESCRIPTION, FK_CALENDAR, FK_CURRENCY,
     FK_CURVEMAN, FK_CURVEACC, FK_SOURCE_FRONT, FK_SOURCE_BACK)
  VALUES
    (v_conf_pk, c_owner_conf, '{{CONF_DESCRIPTION}}', {{FK_CALENDAR}}, {{FK_CURRENCY}},
     v_curve_pk, v_curve_pk, c_source_front, c_source_back);

  -- ==========================================================================
  -- STEP 3 — Fixing curve header                         →  BOX_FE.T_BOX_ENGFCURVE_S
  -- What        : the curve this configuration prices from. 1 row
  -- Source      : DEVENG.T_PGT_ENGFCURVE_S {{GBO_CURVE_PK}} (Q-03). Its GBO PK is a filter, never copied.
  --               NOT NULL columns shown; add any other column Q-03 mines, classified
  -- Findings    : row 3, {{STATUS_3}}
  -- If wrong    : the branch prices off the wrong curve, silently, in a batch
  -- ==========================================================================
  -- PK allocated in step 2
  INSERT INTO BOX_FE.T_BOX_ENGFCURVE_S (PK, FK_OWNER_OBJ, DESCRIPTION, FK_CURRENCY)
  VALUES (v_curve_pk, c_owner_fcurve, '{{CURVE_DESCRIPTION}}', {{CURVE_FK_CURRENCY}});

  -- ==========================================================================
  -- STEP 4 — Curve → quote references                    →  BOX_FE.T_BOX_ENGLKFC_X
  -- What        : the curve's quote array. Runtime enumeration is {{EXPECTED_QUOTE_REFS}} rows
  -- Source      : READ HERE from DEVENG.T_PGT_ENGLKFC_X WHERE FK_PARENT = GBO curve — no typed list.
  --               Column {{QUOTE_REF_COLUMN}} per Q-04c outcome {{Q04C_OUTCOME}}
  -- Findings    : row 4, {{STATUS_4}}
  -- If wrong    : fixings missing for some currencies; the pre-commit below catches only part of it
  -- ==========================================================================
  SELECT COUNT(DISTINCT {{QUOTE_REF_COLUMN}}) INTO v_n
  FROM   DEVENG.T_PGT_ENGLKFC_X WHERE FK_PARENT = c_gbo_curve_pk;
  IF v_n <> c_expected_quote_refs THEN
    RAISE_APPLICATION_ERROR(-20004, 'Step 4: ' || v_n || ' quote refs in DEVENG, evidence says '
      || c_expected_quote_refs);
  END IF;
  FOR r IN (SELECT DISTINCT {{QUOTE_REF_COLUMN}} AS quote_ref
            FROM   DEVENG.T_PGT_ENGLKFC_X WHERE FK_PARENT = c_gbo_curve_pk) LOOP
    v_pk := F___SEQUENCE('T_BOX_ENGLKFC_X','X');  chk_pk(v_pk, 'T_BOX_ENGLKFC_X');
    INSERT INTO BOX_FE.T_BOX_ENGLKFC_X (PK, FK_OWNER_OBJ, FK_EXTENSION, FK_PARENT, FK_BS)
    VALUES (v_pk, c_owner_fcurve, c_ext_englkfc, v_curve_pk, r.quote_ref);
  END LOOP;

  -- curve validation — no DML, safe as a gate (read 2026-09-21)
  PKG_ENGPRECOMMIT.P_ENGFixingCurve_PreCommit(v_curve_pk);

  -- ==========================================================================
  -- STEP 5 — Branch association                          →  BOX_FE.T_BOX_ENGCONF_X
  -- What        : ties the configuration to the branch. 1 row
  -- Source      : FK_BS = BRANCH_PK (Q-G1)
  -- Findings    : row 5, {{STATUS_5}}
  -- If wrong    : a configuration that belongs to nobody — nothing runs for the branch
  -- ==========================================================================
  v_pk := F___SEQUENCE('T_BOX_ENGCONF_X','X');  chk_pk(v_pk, 'T_BOX_ENGCONF_X');
  INSERT INTO BOX_FE.T_BOX_ENGCONF_X (PK, FK_OWNER_OBJ, FK_EXTENSION, FK_PARENT, FK_BS)
  VALUES (v_pk, c_owner_conf, c_ext_conf_x, v_conf_pk, c_branch_pk);

  -- ==========================================================================
  -- STEP 6 — Accrual tab, one row per approved instrument →  BOX_FE.T_BOX_ENGACCRCONF_S
  -- What        : {{N_INSTRUMENTS}} rows — the instrument set IS gate 0c's answer
  -- Source      : values signed by {{SIGNER_6}} — see findings row 6 for GBO and reference values
  -- Findings    : row 6, {{STATUS_6}}
  -- If wrong    : interest and fees accrue on the wrong basis; nothing fails, the numbers are wrong
  -- ==========================================================================
  {{STEP_6_ROWS}}
  -- one block per instrument:
  -- v_pk := F___SEQUENCE('T_BOX_ENGACCRCONF_S','X');  chk_pk(v_pk, 'T_BOX_ENGACCRCONF_S');
  -- INSERT INTO BOX_FE.T_BOX_ENGACCRCONF_S (PK, FK_OWNER_OBJ, FK_PARENT, FK_EXTENSION, FK_INSTRUMENT,
  --   FK_FEEFIRSTDAYSEL, FK_INTFIRSTDAYSEL, INTCOMMONBASIS, BYTRIGGER, BYRESIDUAL, INTERVAL, FK_BASIS, FK_MDRBASIS)
  -- VALUES (v_pk, c_owner_conf, v_conf_pk, c_ext_accrconf, <instrument>, <signed values…>);

  -- ==========================================================================
  -- STEP 7 — Accrual exceptions                          →  BOX_FE.T_BOX_CONFIG_ACCRUAL_S
  -- What        : this branch's exceptions, approved instruments only. Runtime enumeration is {{EXPECTED_EXCEPTIONS}} rows
  -- Source      : READ HERE from DEVENG.T_PGT_CONFIG_ACCRUAL_S (Q-06): GBO FK_BRANCH is a branch CONFIG,
  --               resolved to the branch through PGT_STC.T_PGT_BRANCH_CONFIG_S. BOX FK_BRANCH = BRANCH_PK.
  --               CRITERIAL copied from the GBO row.
  -- Findings    : row 7, {{STATUS_7}} — rows filtered out, and why, are listed there
  -- If wrong    : another branch's exception rules applied to this branch
  -- ==========================================================================
  SELECT COUNT(*) INTO v_n
  FROM   DEVENG.T_PGT_CONFIG_ACCRUAL_S g
  JOIN   PGT_STC.T_PGT_BRANCH_CONFIG_S bc ON bc.PK = g.FK_BRANCH
  WHERE  g.FK_PARENT = c_gbo_config_pk
  AND    bc.FK_BRANCH = c_branch_pk
  AND    g.FK_INSTRUMENT IN ({{APPROVED_INSTRUMENTS}});
  IF v_n <> c_expected_exceptions THEN
    RAISE_APPLICATION_ERROR(-20007, 'Step 7: ' || v_n || ' exceptions in DEVENG, evidence says '
      || c_expected_exceptions);
  END IF;
  FOR r IN (SELECT g.FK_INSTRUMENT, g.FK_STRATEGY, g.FK_INSTRTYPE, g.CRITERIAL
            FROM   DEVENG.T_PGT_CONFIG_ACCRUAL_S g
            JOIN   PGT_STC.T_PGT_BRANCH_CONFIG_S bc ON bc.PK = g.FK_BRANCH
            WHERE  g.FK_PARENT = c_gbo_config_pk
            AND    bc.FK_BRANCH = c_branch_pk
            AND    g.FK_INSTRUMENT IN ({{APPROVED_INSTRUMENTS}})) LOOP
    v_pk := F___SEQUENCE('T_BOX_CONFIG_ACCRUAL_S','X');  chk_pk(v_pk, 'T_BOX_CONFIG_ACCRUAL_S');
    INSERT INTO BOX_FE.T_BOX_CONFIG_ACCRUAL_S
      (PK, FK_OWNER_OBJ, FK_PARENT, FK_EXTENSION, CRITERIAL, FK_BRANCH, FK_INSTRUMENT, FK_STRATEGY, FK_INSTRTYPE)
    VALUES
      (v_pk, c_owner_conf, v_conf_pk, c_ext_config_accrual, r.CRITERIAL, c_branch_pk,
       r.FK_INSTRUMENT, r.FK_STRATEGY, r.FK_INSTRTYPE);
  END LOOP;

  -- STEP 8 — Fixing exceptions → T_BOX_FIXING_BY_INSTR_S. {{N_STEP8}} rows — {{STEP_8_LINE}}

  -- ==========================================================================
  -- STEP 11 — Book registration                          →  BOX_FE.T_BOX_CONF_BY_BOOK_S
  -- What        : (books + 1 dummy) × instruments = {{N_BOOK_ROWS}} rows
  -- Source      : books {{BOOKS}} signed by {{SIGNER_11}}; dummy book DUMMY_BOOK_LABEL (Q-10c)
  -- Columns     : Q-G7's declared fields (pBranch, pInstrument, pLabel) + identity. FK_PARENT/FK_EXTENSION
  --               because Q-G7 declares this table as Config's amConfigByBook extension — confirm per run
  -- Findings    : row 11, {{STATUS_11}}
  -- If wrong    : a (book, instrument) never processed by the FE batch — silently
  -- ==========================================================================
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_CONF_BY_BOOK_S WHERE FK_BRANCH = c_branch_pk;
  IF v_n <> 0 THEN
    RAISE_APPLICATION_ERROR(-20011, 'Step 11: the branch already has ' || v_n || ' book rows — not a new build');
  END IF;
  FOR i IN (SELECT COLUMN_VALUE AS instrument FROM TABLE(sys.odcinumberlist({{APPROVED_INSTRUMENTS}}))) LOOP
    FOR b IN (SELECT COLUMN_VALUE AS label FROM TABLE(sys.odcinumberlist({{BOOK_LABELS}}, c_dummy_book))) LOOP
      v_pk := F___SEQUENCE('T_BOX_CONF_BY_BOOK_S','X');  chk_pk(v_pk, 'T_BOX_CONF_BY_BOOK_S');
      INSERT INTO BOX_FE.T_BOX_CONF_BY_BOOK_S
        (PK, FK_OWNER_OBJ, FK_PARENT, FK_EXTENSION, FK_BRANCH, FK_INSTRUMENT, FK_LABEL)
      VALUES (v_pk, c_owner_conf, v_conf_pk, c_ext_conf_by_book, c_branch_pk, i.instrument, b.label);
    END LOOP;
  END LOOP;

  -- ==========================================================================
  -- STEP 12 — Allowed errors                             →  BOX_FE.T_BOX_ERRORS_FE_S
  -- What        : one row per approved instrument, {{N_INSTRUMENTS}} rows. No FK_PARENT, no FK_EXTENSION
  -- Source      : LIMIT_ERRORS proposed from the reference branch per ADR 0004, signed by {{SIGNER_12}}
  -- Findings    : row 12, {{STATUS_12}}
  -- If wrong    : 0 aborts the load on the first failed deal; too high hides failures
  -- ==========================================================================
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_ERRORS_FE_S WHERE FK_BRANCH = c_branch_pk;
  IF v_n <> 0 THEN   -- the rollback and verify find step-12 rows by branch, so there must be none before
    RAISE_APPLICATION_ERROR(-20012, 'Step 12: the branch already has ' || v_n || ' allowed-error rows');
  END IF;
  {{STEP_12_ROWS}}
  -- one block per instrument:
  -- v_pk := F___SEQUENCE('T_BOX_ERRORS_FE_S','X');  chk_pk(v_pk, 'T_BOX_ERRORS_FE_S');
  -- INSERT INTO BOX_FE.T_BOX_ERRORS_FE_S (PK, FK_OWNER_OBJ, FK_BRANCH, FK_INSTRUMENT, LIMIT_ERRORS)
  -- VALUES (v_pk, c_owner_errors, c_branch_pk, <instrument>, <signed limit>);

  -- ==========================================================================
  -- STEP 14a — Days matured, missing instruments only    →  BOX_FE.T_BOX_ENGDAYS_MATURED_S
  -- What        : {{N_DAYS_MATURED}} rows — only the approved instruments Q-12 (a) found without one
  -- Source      : NUM_DAYS proposed from the reference branch's environment (Q-12 b), signed by {{SIGNER_14A}}
  -- Findings    : row 14a, {{STATUS_14A}}
  -- If wrong    : matured deals of that instrument handled on the wrong horizon
  -- ==========================================================================
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_ENGDAYS_MATURED_S
  WHERE  FK_INSTRUMENT IN ({{DAYS_MATURED_INSTRUMENTS}});
  IF v_n <> 0 THEN   -- Q-12 (a) found none; someone added one since — do not duplicate it
    RAISE_APPLICATION_ERROR(-20014, 'Step 14a: ' || v_n || ' Days Matured row(s) now exist for instruments Q-12 found missing');
  END IF;
  {{STEP_14A_ROWS}}
  -- one block per missing instrument:
  -- v_pk := F___SEQUENCE('T_BOX_ENGDAYS_MATURED_S','X');  chk_pk(v_pk, 'T_BOX_ENGDAYS_MATURED_S');
  -- INSERT INTO BOX_FE.T_BOX_ENGDAYS_MATURED_S (PK, FK_OWNER_OBJ, DDATE, FK_INSTRUMENT, NUM_DAYS)
  -- VALUES (v_pk, c_owner_days_matured, SYSDATE, <instrument>, <signed days>);

  -- ==========================================================================
  -- Configuration pre-commit — ⚠ WRITES AND COMMITS. Last statement on purpose.
  -- Back-fills step 8's curve columns; with no step-8 rows it should find nothing to do.
  -- ==========================================================================
  PKG_ENGPRECOMMIT.p_check_Val_Curves_precommit(v_conf_pk);
  DBMS_OUTPUT.PUT_LINE('Done. Configuration ' || v_conf_pk || ', curve ' || v_curve_pk ||
                       '. Now run the verify script.');
END;
