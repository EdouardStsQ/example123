--# ===========================================================================================
--# TEMPLATE for scripts/render_sql.py. NEVER fill it by hand - write 03-sql/values.json and run
--#     python3 scripts/render_sql.py <RUN_FOLDER>
--# Lines starting with --# are template notes and are not rendered. "-- @@BEGIN <key>" /
--# "-- @@END <key>" keep the lines between them only when <key> applies ("a&b" = both apply,
--# "!a" = a does not). Keys: apply (the config file), rehearsal (the rehearsal file), draft (a step
--# is still held), step4 step6 step7 step11 step12 step14a (the step is emitted).
--# This one template renders TWO files: <BASE>-rehearsal.sql and <BASE>-config.sql. They are the
--# same block; only the last lines differ (ROLLBACK vs. the committing Config pre-commit).
--# Keep it ASCII: the renderer refuses any other character (SQL Developer may read the file as
--# Cp1252, and a mis-read character inside a string literal would be written to the database).
--# ===========================================================================================
SET DEFINE OFF
-- ============================================================================
-- {{BRANCH_CODE}} - BOX FE configuration - {{TARGET_ENV}}
-- @@BEGIN rehearsal
-- REHEARSAL (1 of 4). Runs every statement of the config file, then ROLLBACK. Nothing is kept.
-- @@END rehearsal
-- @@BEGIN apply
-- CONFIG (2 of 4). APPLIES AND COMMITS.
-- @@END apply
-- {{RENDERED_LINE}}
-- @@BEGIN draft
-- DRAFT - NOT FOR APPLY. Held steps: {{HELD_STEPS}}. The config file stops on its first statement.
-- @@END draft
--
-- Run order (operator):
--   1. {{BASE}}-rehearsal.sql
--      every statement and every check, then ROLLBACK. Last line must read "REHEARSAL OK".
--      Safe to run as often as needed.
--   2. {{BASE}}-config.sql
--      the same block; its last statement is the Config pre-commit, which COMMITS.
--      Last line must read "DONE - committed".
--   3. {{BASE}}-verify.sql
--      read-only, on the operator's read-only account. Each query states its expected result.
--   4. {{BASE}}-rollback.sql
--      ONLY to undo 2. There is no other undo: a ROLLBACK statement after 2 does nothing.
--
-- Any error before the Config pre-commit stops the block, and Oracle undoes everything the block did
-- (an unhandled exception rolls back the whole anonymous block): nothing is kept. The block refuses to
-- start if the session has uncommitted work of its own (the pre-commit's COMMIT would keep it too).
-- An error raised by the Config pre-commit ITSELF may come after its COMMIT: if the last line is not
-- "DONE - committed", run the verify file's V2 before anything else, and send the output.
-- BOX_FE only: the applying account reads and writes BOX_FE and nothing else.
-- Every value below is from 03-sql/values.json, with its source beside it.
-- ============================================================================
SET AUTOCOMMIT OFF
SET SERVEROUTPUT ON SIZE UNLIMITED
ALTER SESSION SET NLS_NUMERIC_CHARACTERS = '.,';
DECLARE
  -- environment: F___SEQUENCE adds the auth-code fraction itself; this block only checks it
  c_expected_auth_code  CONSTANT NUMBER := {{TARGET_AUTH_CODE}};   -- {{SRC_TARGET_AUTH_CODE}}
  c_expected_fraction   CONSTANT NUMBER := {{TARGET_PK_FRACTION}};   -- auth code / 10^digits

  -- identity per destination object (Q-G7 derivation / Q-G6) - never sampled from rows
  c_owner_conf          CONSTANT NUMBER := {{OWNER_ENGCONF}};   -- BOX_ENG_Config. {{SRC_OWNER_ENGCONF}}
  c_ext_conf_x          CONSTANT NUMBER := {{EXT_ENGCONF_X}};   -- apBranch. {{SRC_EXT_ENGCONF_X}}
  c_ext_accrconf        CONSTANT NUMBER := {{EXT_ENGACCRCONF}};   -- amAccrualConfig. {{SRC_EXT_ENGACCRCONF}}
  c_ext_config_accrual  CONSTANT NUMBER := {{EXT_CONFIG_ACCRUAL}};   -- BOX_ENG_Config_Accrual. {{SRC_EXT_CONFIG_ACCRUAL}}
  c_ext_conf_by_book    CONSTANT NUMBER := {{EXT_CONF_BY_BOOK}};   -- amConfigByBook. {{SRC_EXT_CONF_BY_BOOK}}
  c_owner_fcurve        CONSTANT NUMBER := {{OWNER_ENGFCURVE}};   -- BOX_ENG_FixingCurve. {{SRC_OWNER_ENGFCURVE}}
  c_ext_englkfc         CONSTANT NUMBER := {{EXT_ENGLKFC}};   -- apQuoteReference. {{SRC_EXT_ENGLKFC}}
  c_owner_errors        CONSTANT NUMBER := {{OWNER_ERRORS_FE}};   -- BOX - Limit Error Assign. {{SRC_OWNER_ERRORS_FE}}
  c_owner_days_matured  CONSTANT NUMBER := {{OWNER_DAYS_MATURED}};   -- BOX_ENG_Days_Matured. {{SRC_OWNER_DAYS_MATURED}}

  -- references
  c_branch_pk           CONSTANT NUMBER := {{BRANCH_PK}};   -- {{SRC_BRANCH_PK}}
  c_source_front        CONSTANT NUMBER := {{SOURCE_FRONT}};   -- Murex instance. {{SRC_SOURCE_FRONT}}
  c_source_back         CONSTANT NUMBER := 586.4;   -- BOX is always the back source [stated: BOX FE expert, 2026-09-23]
-- @@BEGIN step11
  c_dummy_book          CONSTANT NUMBER := {{DUMMY_BOOK_LABEL}};   -- {{DUMMY_BOOK_NAME}}. {{SRC_DUMMY_BOOK}}
-- @@END step11
-- @@BEGIN step4
  c_expected_quote_refs CONSTANT PLS_INTEGER := {{STATED_QUOTE_REFS}};   -- stated count, {{SRC_EXPECTED_QUOTE_REFS}}
  -- the quote-reference set, generated from 01-evidence/Q-04c-quote-ref-column-gbo.csv, column FK_BS (GBO curve {{GBO_CURVE_PK}})
  v_quote_refs          sys.odcinumberlist := {{QUOTE_REFS_LIST}};
-- @@END step4
-- @@BEGIN step7
  c_expected_exceptions CONSTANT PLS_INTEGER := {{STATED_EXCEPTIONS}};   -- stated count, {{SRC_EXPECTED_EXCEPTIONS}}
-- @@END step7

  v_conf_pk   NUMBER;
  v_curve_pk  NUMBER;
  v_pk        NUMBER;
  v_n         PLS_INTEGER;
  v_txn       VARCHAR2(200);

  -- every allocated PK carries the auth-code fraction this block was built for. The first call is
  -- before the first INSERT, so a block run in the wrong environment stops having written nothing.
  -- It also checks the PK is not already used (a sequence behind its table would duplicate PKs silently).
  PROCEDURE chk_pk (p_pk NUMBER, p_table VARCHAR2) IS
    v_used PLS_INTEGER;
  BEGIN
    IF p_pk IS NULL OR p_pk - TRUNC(p_pk) <> c_expected_fraction THEN
      RAISE_APPLICATION_ERROR(-20001, p_table || ': PK ' || p_pk || ' carries fraction '
        || (p_pk - TRUNC(p_pk)) || ', this block was built for auth code ' || c_expected_auth_code
        || ' (' || c_expected_fraction || '). Wrong environment? Nothing has been kept.');
    END IF;
    EXECUTE IMMEDIATE 'SELECT COUNT(*) FROM BOX_FE.' || p_table || ' WHERE PK = :pk' INTO v_used USING p_pk;
    IF v_used <> 0 THEN
      RAISE_APPLICATION_ERROR(-20003, p_table || ': the new PK ' || p_pk || ' is already used - the sequence '
        || 'is behind the table. Ask the BOX FE team. Nothing has been kept.');
    END IF;
  END chk_pk;

  -- a count this block expects. Prints it; stops the block (undoing everything) if it differs.
  PROCEDURE expect_rows (p_what VARCHAR2, p_got PLS_INTEGER, p_want PLS_INTEGER) IS
  BEGIN
    DBMS_OUTPUT.PUT_LINE(RPAD(p_what, 64) || LPAD(TO_CHAR(p_got), 5) || '  (expected ' || p_want || ')');
    IF p_got <> p_want THEN
      RAISE_APPLICATION_ERROR(-20002, p_what || ': ' || p_got || ' row(s), expected ' || p_want
        || '. Stopped; nothing has been kept.');
    END IF;
  END expect_rows;
BEGIN
  IF DBMS_TRANSACTION.LOCAL_TRANSACTION_ID IS NOT NULL THEN
    RAISE_APPLICATION_ERROR(-20097, 'This session has an open transaction (a failed earlier run, or work of '
      || 'your own). Type ROLLBACK; - or COMMIT; only to keep work of your own - and run this file again. '
      || 'Nothing has been done.');
  END IF;
-- @@BEGIN draft&apply
  RAISE_APPLICATION_ERROR(-20099, 'DRAFT - not for apply: step(s) {{HELD_STEPS}} still held. Render again once decided.');
-- @@END draft&apply
  -- the two recorded values must agree (Q-G3c). A typo in either stops here.
  IF c_expected_fraction <> c_expected_auth_code / POWER(10, LENGTH(TO_CHAR(c_expected_auth_code))) THEN
    RAISE_APPLICATION_ERROR(-20000, 'Auth code ' || c_expected_auth_code || ' and fraction '
      || c_expected_fraction || ' disagree - re-read Q-G3c');
  END IF;
  DBMS_OUTPUT.PUT_LINE('Built for auth code ' || c_expected_auth_code || ': every PK must end in ' || c_expected_fraction);

  -- ==========================================================================
  -- STEP 0 - Pre-flight: a new build, and nothing it will write exists yet
  -- What        : read-only counts before the first write. Any non-zero count stops the block
  -- Source      : Q-01 (step 1 CONFIRMED_ABSENT); the DESCRIPTION collision pre-checks (Q-02, Q-03);
  --               steps 11, 12 and 14a are keyed by branch or instrument, so the rollback relies on
  --               none of their rows existing before this block
  -- If wrong    : a second configuration for the branch, or a rollback that deletes rows it did not create
  -- ==========================================================================
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_ENGCONF_X WHERE FK_BS = c_branch_pk;
  expect_rows('pre-flight: T_BOX_ENGCONF_X rows for the branch (Q-01)', v_n, 0);
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_ENGCONF_S WHERE DESCRIPTION = {{CONF_DESCRIPTION_SQL}};
  expect_rows('pre-flight: T_BOX_ENGCONF_S with this DESCRIPTION', v_n, 0);
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = {{CURVE_DESCRIPTION_SQL}};
  expect_rows('pre-flight: T_BOX_ENGFCURVE_S with this DESCRIPTION', v_n, 0);
-- @@BEGIN step11
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_CONF_BY_BOOK_S WHERE FK_BRANCH = c_branch_pk;
  expect_rows('pre-flight: T_BOX_CONF_BY_BOOK_S rows for the branch', v_n, 0);
-- @@END step11
-- @@BEGIN step12
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_ERRORS_FE_S WHERE FK_BRANCH = c_branch_pk;
  expect_rows('pre-flight: T_BOX_ERRORS_FE_S rows for the branch', v_n, 0);
-- @@END step12
-- @@BEGIN step14a
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_ENGDAYS_MATURED_S WHERE FK_INSTRUMENT IN ({{DAYS_MATURED_INSTRUMENTS}});
  expect_rows('pre-flight: T_BOX_ENGDAYS_MATURED_S for the missing instruments', v_n, 0);
-- @@END step14a

  -- ==========================================================================
  -- STEP 2 - MIS configuration header                    ->  BOX_FE.T_BOX_ENGCONF_S
  -- What        : the configuration. 1 row. The curve's PK is allocated here too, because
  --               FK_CURVEMAN/FK_CURVEACC are NOT NULL (no NULL-then-UPDATE: ORA-01400)
  -- Source      : DESCRIPTION {{SRC_CONF_DESCRIPTION}}; FK_CALENDAR {{SRC_FK_CALENDAR}};
  --               FK_CURRENCY {{SRC_FK_CURRENCY}}. GBO config {{GBO_CONFIG_PK}} ({{SRC_GBO_CONFIG_PK}})
  --               FK_SOURCE_FRONT = c_source_front, FK_SOURCE_BACK = 586.4 - NOT mined
  -- Findings    : row 2, {{STATUS_2}}
  -- If wrong    : the batch reads the wrong sources or calendar for every deal of the branch
  -- ==========================================================================
  v_conf_pk  := {{SEQ}}('T_BOX_ENGCONF_S','X');    chk_pk(v_conf_pk,  'T_BOX_ENGCONF_S');
  v_curve_pk := {{SEQ}}('T_BOX_ENGFCURVE_S','X');  chk_pk(v_curve_pk, 'T_BOX_ENGFCURVE_S');
  INSERT INTO BOX_FE.T_BOX_ENGCONF_S
    (PK, FK_OWNER_OBJ, DESCRIPTION, FK_CALENDAR, FK_CURRENCY,
     FK_CURVEMAN, FK_CURVEACC, FK_SOURCE_FRONT, FK_SOURCE_BACK)
  VALUES
    (v_conf_pk, c_owner_conf, {{CONF_DESCRIPTION_SQL}}, {{FK_CALENDAR}}, {{FK_CURRENCY}},
     v_curve_pk, v_curve_pk, c_source_front, c_source_back);
  v_txn := DBMS_TRANSACTION.LOCAL_TRANSACTION_ID;   -- the one transaction every row of this block belongs to

  -- ==========================================================================
  -- STEP 3 - Fixing curve header                         ->  BOX_FE.T_BOX_ENGFCURVE_S
  -- What        : the curve this configuration prices from. 1 row. PK allocated in step 2
  -- Source      : DESCRIPTION {{SRC_CURVE_DESCRIPTION}}; FK_CURRENCY {{SRC_CURVE_FK_CURRENCY}}.
  --               GBO curve {{GBO_CURVE_PK}} ({{SRC_GBO_CURVE_PK}}) - a filter, never copied
  -- Findings    : row 3, {{STATUS_3}}
  -- If wrong    : the branch prices off the wrong curve, silently, in a batch
  -- ==========================================================================
  INSERT INTO BOX_FE.T_BOX_ENGFCURVE_S (PK, FK_OWNER_OBJ, DESCRIPTION, FK_CURRENCY)
  VALUES (v_curve_pk, c_owner_fcurve, {{CURVE_DESCRIPTION_SQL}}, {{CURVE_FK_CURRENCY}});

  -- ==========================================================================
  -- STEP 4 - Curve -> quote references                   ->  BOX_FE.T_BOX_ENGLKFC_X
  -- What        : the curve's quote array. {{EXPECTED_QUOTE_REFS}} rows, one per value of the generated list
  -- Source      : Q-04c (a), column FK_BS, generated by the renderer - never typed.
  --               Checked: validator (SQL = CSV) and verify V4 (BOX = GBO, both ways)
  -- Findings    : row 4, {{STATUS_4}}
  -- If wrong    : fixings missing for some currencies; the curve pre-commit below catches only part of it
  -- ==========================================================================
  IF v_quote_refs.COUNT <> c_expected_quote_refs THEN
    RAISE_APPLICATION_ERROR(-20004, 'Step 4: ' || v_quote_refs.COUNT || ' quote refs in the list, evidence says '
      || c_expected_quote_refs);
  END IF;
  FOR i IN 1 .. v_quote_refs.COUNT LOOP
    v_pk := {{SEQ}}('T_BOX_ENGLKFC_X','X');  chk_pk(v_pk, 'T_BOX_ENGLKFC_X');
    INSERT INTO BOX_FE.T_BOX_ENGLKFC_X (PK, FK_OWNER_OBJ, FK_EXTENSION, FK_PARENT, FK_BS)
    VALUES (v_pk, c_owner_fcurve, c_ext_englkfc, v_curve_pk, v_quote_refs(i));
  END LOOP;

  -- curve validation, after its array exists - no DML, safe as a gate (read 2026-09-21)
  {{PKG}}.P_ENGFixingCurve_PreCommit(v_curve_pk);

  -- ==========================================================================
  -- STEP 5 - Branch association                          ->  BOX_FE.T_BOX_ENGCONF_X
  -- What        : ties the configuration to the branch. 1 row
  -- Source      : FK_BS = c_branch_pk (Q-01c)
  -- Findings    : row 5, {{STATUS_5}}
  -- If wrong    : a configuration that belongs to nobody - nothing runs for the branch
  -- ==========================================================================
  v_pk := {{SEQ}}('T_BOX_ENGCONF_X','X');  chk_pk(v_pk, 'T_BOX_ENGCONF_X');
  INSERT INTO BOX_FE.T_BOX_ENGCONF_X (PK, FK_OWNER_OBJ, FK_EXTENSION, FK_PARENT, FK_BS)
  VALUES (v_pk, c_owner_conf, c_ext_conf_x, v_conf_pk, c_branch_pk);

-- @@BEGIN step6
  -- ==========================================================================
  -- STEP 6 - Accrual tab, one row per approved instrument ->  BOX_FE.T_BOX_ENGACCRCONF_S
  -- What        : {{N_STEP6}} row(s) - the instrument set is gate 0c's answer
  -- Source      : {{SRC_6}}
  -- Findings    : row 6, {{STATUS_6}}
  -- If wrong    : interest and fees accrue on the wrong basis; nothing fails, the numbers are wrong
  -- ==========================================================================
{{STEP_6_ROWS}}

-- @@END step6
-- @@BEGIN step7
  -- ==========================================================================
  -- STEP 7 - Accrual exceptions                          ->  BOX_FE.T_BOX_CONFIG_ACCRUAL_S
  -- What        : this branch's exceptions, approved instruments only. {{EXPECTED_EXCEPTIONS}} row(s)
  -- Source      : Q-06c, filtered to BRANCH_PK {{BRANCH_PK}} (GBO's FK_BRANCH is a branch CONFIG) and to
  --               the approved instruments, generated by the renderer. BOX FK_BRANCH = c_branch_pk.
  --               CRITERIAL copied from the GBO row. Rows filtered out: 03-sql/render-report.md.
  --               Checked: validator (SQL = CSV) and verify V10 (BOX = GBO, both ways)
  -- Findings    : row 7, {{STATUS_7}}
  -- If wrong    : another branch's exception rules applied to this branch
  -- ==========================================================================
  v_n := 0;
  FOR r IN ({{EXCEPTION_ROWS}}) LOOP
    v_pk := {{SEQ}}('T_BOX_CONFIG_ACCRUAL_S','X');  chk_pk(v_pk, 'T_BOX_CONFIG_ACCRUAL_S');
    INSERT INTO BOX_FE.T_BOX_CONFIG_ACCRUAL_S
      (PK, FK_OWNER_OBJ, FK_PARENT, FK_EXTENSION, CRITERIAL, FK_BRANCH, FK_INSTRUMENT, FK_STRATEGY, FK_INSTRTYPE)
    VALUES
      (v_pk, c_owner_conf, v_conf_pk, c_ext_config_accrual, r.CRITERIAL, c_branch_pk,
       r.FK_INSTRUMENT, r.FK_STRATEGY, r.FK_INSTRTYPE);
    v_n := v_n + 1;
  END LOOP;
  IF v_n <> c_expected_exceptions THEN
    RAISE_APPLICATION_ERROR(-20007, 'Step 7: ' || v_n || ' exception rows, evidence says ' || c_expected_exceptions);
  END IF;
-- @@END step7

  -- STEP 8 - Fixing exceptions -> T_BOX_FIXING_BY_INSTR_S. 0 rows - {{STATUS_8}} ({{SRC_8}})

-- @@BEGIN step11
  -- ==========================================================================
  -- STEP 11 - Book registration                          ->  BOX_FE.T_BOX_CONF_BY_BOOK_S
  -- What        : (books + 1 dummy) x instruments = {{N_STEP11}} row(s)
  -- Source      : books {{BOOKS_TEXT}}; dummy book c_dummy_book. {{SRC_11}}
  -- Findings    : row 11, {{STATUS_11}}
  -- If wrong    : a (book, instrument) never processed by the FE batch - silently
  -- ==========================================================================
{{STEP_11_ROWS}}

-- @@END step11
-- @@BEGIN step12
  -- ==========================================================================
  -- STEP 12 - Allowed errors                             ->  BOX_FE.T_BOX_ERRORS_FE_S
  -- What        : one row per approved instrument, {{N_STEP12}} row(s). No FK_PARENT, no FK_EXTENSION
  -- Source      : {{SRC_12}}
  -- Findings    : row 12, {{STATUS_12}}
  -- If wrong    : 0 aborts the load on the first failed deal; too high hides failures
  -- ==========================================================================
{{STEP_12_ROWS}}

-- @@END step12
-- @@BEGIN step14a
  -- ==========================================================================
  -- STEP 14a - Days matured, missing instruments only    ->  BOX_FE.T_BOX_ENGDAYS_MATURED_S
  -- What        : {{N_STEP14A}} row(s) - only the approved instruments Q-12 (a) found without one
  -- Source      : {{SRC_14A}}
  -- Findings    : row 14a, {{STATUS_14A}}
  -- If wrong    : matured deals of that instrument handled on the wrong horizon
  -- ==========================================================================
{{STEP_14A_ROWS}}

-- @@END step14a

  -- ==========================================================================
  -- SELF-CHECK - count what this block wrote, before anything is kept
  -- ==========================================================================
  IF NVL(DBMS_TRANSACTION.LOCAL_TRANSACTION_ID, '-') <> v_txn THEN
    RAISE_APPLICATION_ERROR(-20098, 'A called routine committed or rolled back in the middle of the block. '
      || 'Stop: run the verify file V2 and ask the BOX FE team (Q-G3d).');
  END IF;
{{SELF_CHECK}}

-- @@BEGIN apply
  -- ==========================================================================
  -- Configuration pre-commit - WRITES AND COMMITS. Last statement on purpose.
  -- Back-fills step 8's curve columns; with no step-8 rows it finds nothing to do.
  -- ==========================================================================
  DBMS_OUTPUT.PUT_LINE('Calling the Config pre-commit (it COMMITS) ...');
  {{PKG}}.p_check_Val_Curves_precommit(v_conf_pk);
  IF DBMS_TRANSACTION.LOCAL_TRANSACTION_ID = v_txn THEN       -- it never committed: treat as a refusal
    RAISE_APPLICATION_ERROR(-20094, 'The Config pre-commit returned without committing: nothing has been kept. '
      || 'Send this output to the BOX FE team (Q-G3d (a)).');
  ELSIF DBMS_TRANSACTION.LOCAL_TRANSACTION_ID IS NOT NULL THEN   -- it committed, then wrote more
    COMMIT;
    DBMS_OUTPUT.PUT_LINE('Note: the Config pre-commit left work open after its COMMIT; committed here.');
  END IF;
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_ENGCONF_S WHERE PK = v_conf_pk;
  IF v_n <> 1 THEN
    RAISE_APPLICATION_ERROR(-20095, 'The Config pre-commit rolled the configuration back: nothing has been kept. '
      || 'Send this output to the BOX FE team.');
  END IF;
  DBMS_OUTPUT.PUT_LINE('DONE - committed. Configuration ' || v_conf_pk || ', curve ' || v_curve_pk
    || '. Now run {{BASE}}-verify.sql.');
-- @@END apply
-- @@BEGIN rehearsal
  -- ==========================================================================
  -- REHEARSAL END - undo everything. The one statement not rehearsed is the Config pre-commit.
  -- ==========================================================================
  ROLLBACK;
-- @@BEGIN !draft
  DBMS_OUTPUT.PUT_LINE('REHEARSAL OK - every statement ran and every check passed. All of it has been '
    || 'rolled back: nothing was kept. Next: {{BASE}}-config.sql.');
-- @@END !draft
-- @@BEGIN draft
  DBMS_OUTPUT.PUT_LINE('REHEARSAL OK (DRAFT - held: {{HELD_STEPS}}) - rolled back, nothing kept. The config '
    || 'file will refuse to run until those steps are decided and the files rendered again.');
-- @@END draft
-- @@END rehearsal
END;
/
