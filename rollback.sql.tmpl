--# TEMPLATE for scripts/render_sql.py - never filled by hand. Section keys as in config.sql.tmpl. ASCII only.
SET DEFINE OFF
-- ============================================================================
-- {{BRANCH_CODE}} - BOX FE configuration - {{TARGET_ENV}}
-- ROLLBACK (4 of 4). ONLY to undo {{BASE}}-config.sql. That file ends with COMMIT, so a ROLLBACK
-- statement undoes nothing; this file is the only undo.
-- {{RENDERED_LINE}}
-- Deletes exactly what the config block created, found the way the verify file finds it, in reverse
-- dependency order. Every delete must remove exactly the number of rows the config block wrote; if
-- any count differs (someone changed the configuration since), the block stops and deletes nothing.
-- It does NOT commit: read the counts, then COMMIT to keep the deletes, or ROLLBACK to abandon them.
-- Do not EXIT or close the session before one of the two (SQL*Plus EXIT commits by default).
-- Step 14a is NOT deleted: Days Matured is global, another branch may rely on the row, and an
-- approved instrument is meant to have one. The rows are listed; remove them only with the BOX FE
-- team's agreement. So to apply the configuration again after this rollback, render again with
-- step 14a CONFIRMED_PRESENT (Q-12 (a) will now find those rows) - the config's pre-flight refuses otherwise.
-- ============================================================================
SET AUTOCOMMIT OFF
SET SERVEROUTPUT ON SIZE UNLIMITED
ALTER SESSION SET NLS_NUMERIC_CHARACTERS = '.,';
DECLARE
  c_branch_pk CONSTANT NUMBER := {{BRANCH_PK}};   -- {{SRC_BRANCH_PK}}
  v_conf_pk   NUMBER;
  v_curve_pk  NUMBER;
  v_n         PLS_INTEGER;

  PROCEDURE expect_rows (p_what VARCHAR2, p_got PLS_INTEGER, p_want PLS_INTEGER) IS
  BEGIN
    DBMS_OUTPUT.PUT_LINE(RPAD(p_what, 64) || LPAD(TO_CHAR(p_got), 5) || '  (expected ' || p_want || ')');
    IF p_got <> p_want THEN
      RAISE_APPLICATION_ERROR(-20102, p_what || ': ' || p_got || ' row(s), expected ' || p_want
        || '. The configuration changed since it was applied. Stopped: nothing has been deleted.');
    END IF;
  END expect_rows;
BEGIN
  IF DBMS_TRANSACTION.LOCAL_TRANSACTION_ID IS NOT NULL THEN   -- the final COMMIT would keep that work too
    RAISE_APPLICATION_ERROR(-20097, 'This session has an open transaction. Type ROLLBACK; - or COMMIT; only '
      || 'to keep work of your own - and run this file again. Nothing has been done.');
  END IF;
  BEGIN
    SELECT PK INTO v_conf_pk FROM BOX_FE.T_BOX_ENGCONF_S WHERE DESCRIPTION = {{CONF_DESCRIPTION_SQL}};
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RAISE_APPLICATION_ERROR(-20100, 'No configuration with this DESCRIPTION - nothing to roll back.');
    WHEN TOO_MANY_ROWS THEN
      RAISE_APPLICATION_ERROR(-20101, 'More than one configuration with this DESCRIPTION - stop and ask.');
  END;
  BEGIN
    SELECT PK INTO v_curve_pk FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = {{CURVE_DESCRIPTION_SQL}};
  EXCEPTION
    WHEN NO_DATA_FOUND THEN
      RAISE_APPLICATION_ERROR(-20100, 'No curve with this DESCRIPTION - stop and ask.');
    WHEN TOO_MANY_ROWS THEN
      RAISE_APPLICATION_ERROR(-20101, 'More than one curve with this DESCRIPTION - stop and ask.');
  END;
  DBMS_OUTPUT.PUT_LINE('Configuration ' || v_conf_pk || ', curve ' || v_curve_pk);

  -- the pair belongs together and to this branch, before anything is deleted
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_ENGCONF_S WHERE PK = v_conf_pk AND FK_CURVEMAN = v_curve_pk;
  expect_rows('check: the configuration points at the curve', v_n, 1);
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_ENGCONF_X WHERE FK_PARENT = v_conf_pk AND FK_BS = c_branch_pk;
  expect_rows('check: the configuration belongs to the branch', v_n, 1);

-- @@BEGIN step14a
  FOR d IN (SELECT PK, FK_INSTRUMENT, NUM_DAYS FROM BOX_FE.T_BOX_ENGDAYS_MATURED_S
            WHERE  FK_INSTRUMENT IN ({{DAYS_MATURED_INSTRUMENTS}})) LOOP
    DBMS_OUTPUT.PUT_LINE('14a kept: Days Matured ' || d.PK || ', instrument ' || d.FK_INSTRUMENT || ', days ' || d.NUM_DAYS);
  END LOOP;
-- @@END step14a
-- @@BEGIN step12
  DELETE FROM BOX_FE.T_BOX_ERRORS_FE_S       WHERE FK_BRANCH = c_branch_pk;
  expect_rows('step 12 deleted from T_BOX_ERRORS_FE_S', SQL%ROWCOUNT, {{N_STEP12}});
-- @@END step12
  DELETE FROM BOX_FE.T_BOX_CONF_BY_BOOK_S    WHERE FK_PARENT = v_conf_pk;
  expect_rows('step 11 deleted from T_BOX_CONF_BY_BOOK_S', SQL%ROWCOUNT, {{N_STEP11}});
  SELECT COUNT(*) INTO v_n FROM BOX_FE.T_BOX_FIXING_BY_INSTR_S WHERE FK_PARENT = v_conf_pk;
  expect_rows('step 8 rows in T_BOX_FIXING_BY_INSTR_S (none written)', v_n, 0);
  DELETE FROM BOX_FE.T_BOX_CONFIG_ACCRUAL_S  WHERE FK_PARENT = v_conf_pk;
  expect_rows('step 7 deleted from T_BOX_CONFIG_ACCRUAL_S', SQL%ROWCOUNT, {{EXPECTED_EXCEPTIONS}});
  DELETE FROM BOX_FE.T_BOX_ENGACCRCONF_S     WHERE FK_PARENT = v_conf_pk;
  expect_rows('step 6 deleted from T_BOX_ENGACCRCONF_S', SQL%ROWCOUNT, {{N_STEP6}});
  DELETE FROM BOX_FE.T_BOX_ENGCONF_X         WHERE FK_PARENT = v_conf_pk;
  expect_rows('step 5 deleted from T_BOX_ENGCONF_X', SQL%ROWCOUNT, 1);
  DELETE FROM BOX_FE.T_BOX_ENGLKFC_X         WHERE FK_PARENT = v_curve_pk;
  expect_rows('step 4 deleted from T_BOX_ENGLKFC_X', SQL%ROWCOUNT, {{EXPECTED_QUOTE_REFS}});
  DELETE FROM BOX_FE.T_BOX_ENGFCURVE_S       WHERE PK = v_curve_pk;
  expect_rows('step 3 deleted from T_BOX_ENGFCURVE_S', SQL%ROWCOUNT, 1);
  DELETE FROM BOX_FE.T_BOX_ENGCONF_S         WHERE PK = v_conf_pk;
  expect_rows('step 2 deleted from T_BOX_ENGCONF_S', SQL%ROWCOUNT, 1);

  DBMS_OUTPUT.PUT_LINE('ROLLBACK READY - every count matched. Nothing is final yet: COMMIT to keep the deletes, ROLLBACK to abandon.');
END;
