-- ============================================================================
-- {{BRANCH_CODE}} — BOX FE configuration — {{TARGET_ENV}}                 ROLLBACK (3 of 3)
-- The only undo: the config script's last procedure COMMITs, so ROLLBACK undoes nothing.
-- Deletes exactly what the config script created, found the same way the verify script finds it.
-- Reverse dependency order. Prints each count; review them against the verify script's V2, THEN COMMIT.
-- ⚠ Step 14a is NOT deleted: Days Matured is global, another branch may already rely on the row, and an
--   approved instrument is meant to have one anyway. The rows are listed; remove them only with the
--   BOX FE team's agreement.
-- ============================================================================
SET DEFINE OFF
SET SERVEROUTPUT ON
DECLARE
  v_conf_pk  NUMBER;
  v_curve_pk NUMBER;
  PROCEDURE say (p VARCHAR2) IS BEGIN DBMS_OUTPUT.PUT_LINE(p || ': ' || SQL%ROWCOUNT); END;
BEGIN
  SELECT PK INTO v_conf_pk  FROM BOX_FE.T_BOX_ENGCONF_S   WHERE DESCRIPTION = '{{CONF_DESCRIPTION}}';
  SELECT PK INTO v_curve_pk FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = '{{CURVE_DESCRIPTION}}';

  FOR d IN (SELECT PK, FK_INSTRUMENT, NUM_DAYS FROM BOX_FE.T_BOX_ENGDAYS_MATURED_S
            WHERE  FK_INSTRUMENT IN ({{DAYS_MATURED_INSTRUMENTS}})) LOOP
    DBMS_OUTPUT.PUT_LINE('14a kept: Days Matured ' || d.PK || ' instrument ' || d.FK_INSTRUMENT || ' days ' || d.NUM_DAYS);
  END LOOP;
  DELETE FROM BOX_FE.T_BOX_ERRORS_FE_S       WHERE FK_BRANCH = {{BRANCH_PK}};  say('12');
  DELETE FROM BOX_FE.T_BOX_CONF_BY_BOOK_S    WHERE FK_PARENT = v_conf_pk;      say('11');
  DELETE FROM BOX_FE.T_BOX_FIXING_BY_INSTR_S WHERE FK_PARENT = v_conf_pk;      say('8');
  DELETE FROM BOX_FE.T_BOX_CONFIG_ACCRUAL_S  WHERE FK_PARENT = v_conf_pk;      say('7');
  DELETE FROM BOX_FE.T_BOX_ENGACCRCONF_S     WHERE FK_PARENT = v_conf_pk;      say('6');
  DELETE FROM BOX_FE.T_BOX_ENGCONF_X         WHERE FK_PARENT = v_conf_pk;      say('5');
  DELETE FROM BOX_FE.T_BOX_ENGLKFC_X         WHERE FK_PARENT = v_curve_pk;     say('4');
  DELETE FROM BOX_FE.T_BOX_ENGFCURVE_S       WHERE PK = v_curve_pk;            say('3');
  DELETE FROM BOX_FE.T_BOX_ENGCONF_S         WHERE PK = v_conf_pk;             say('2');
  -- step 12 is keyed by branch: safe because the config script refused to run if the branch had any
  DBMS_OUTPUT.PUT_LINE('Review the counts above. COMMIT to apply, ROLLBACK to abandon.');
END;
/
