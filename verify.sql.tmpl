--# TEMPLATE for scripts/render_sql.py - never filled by hand. Section keys as in config.sql.tmpl.
--# Every query states its expected result, and every one can fail: no WHERE 1=0, no value compared
--# with itself. Columns are only those the config block writes (known to exist) and GBO columns the
--# query catalogue has confirmed. ASCII only.
SET DEFINE OFF
-- ============================================================================
-- {{BRANCH_CODE}} - BOX FE configuration - {{TARGET_ENV}}
-- VERIFY (3 of 4). Read-only. Run straight after {{BASE}}-config.sql, on the OPERATOR's read-only
-- account (it sees BOX_FE, DEVENG, PGT_* and GOM_GLB_SYS; the applying account sees only BOX_FE).
-- {{RENDERED_LINE}}
-- Every query states its expected result. Anything else is a failure: stop, and report which.
-- The rows this run created are found by the header and curve DESCRIPTIONs (unique - the config
-- block checked), never by a PK typed from the apply log.
-- ============================================================================
ALTER SESSION SET NLS_NUMERIC_CHARACTERS = '.,';

-- V1 - AUTH CODE. Every row this run created carries this environment's auth-code fraction.
-- Expect: 0 rows.
WITH f     AS (SELECT auth_code / POWER(10, LENGTH(TO_CHAR(auth_code))) AS fr FROM gom_glb_sys.t__CORE_INFO_S),
     conf  AS (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S   WHERE DESCRIPTION = {{CONF_DESCRIPTION_SQL}}),
     curve AS (SELECT PK FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = {{CURVE_DESCRIPTION_SQL}}),
     created AS (
       SELECT 'T_BOX_ENGCONF_S' t, PK FROM conf
       UNION ALL SELECT 'T_BOX_ENGFCURVE_S', PK FROM curve
       UNION ALL SELECT 'T_BOX_ENGLKFC_X', PK FROM BOX_FE.T_BOX_ENGLKFC_X WHERE FK_PARENT IN (SELECT PK FROM curve)
       UNION ALL SELECT 'T_BOX_ENGCONF_X', PK FROM BOX_FE.T_BOX_ENGCONF_X WHERE FK_PARENT IN (SELECT PK FROM conf)
-- @@BEGIN step6
       UNION ALL SELECT 'T_BOX_ENGACCRCONF_S', PK FROM BOX_FE.T_BOX_ENGACCRCONF_S WHERE FK_PARENT IN (SELECT PK FROM conf)
-- @@END step6
-- @@BEGIN step7
       UNION ALL SELECT 'T_BOX_CONFIG_ACCRUAL_S', PK FROM BOX_FE.T_BOX_CONFIG_ACCRUAL_S WHERE FK_PARENT IN (SELECT PK FROM conf)
-- @@END step7
-- @@BEGIN step11
       UNION ALL SELECT 'T_BOX_CONF_BY_BOOK_S', PK FROM BOX_FE.T_BOX_CONF_BY_BOOK_S WHERE FK_PARENT IN (SELECT PK FROM conf)
-- @@END step11
-- @@BEGIN step12
       UNION ALL SELECT 'T_BOX_ERRORS_FE_S', PK FROM BOX_FE.T_BOX_ERRORS_FE_S WHERE FK_BRANCH = {{BRANCH_PK}}
-- @@END step12
-- @@BEGIN step14a
       UNION ALL SELECT 'T_BOX_ENGDAYS_MATURED_S', PK FROM BOX_FE.T_BOX_ENGDAYS_MATURED_S WHERE FK_INSTRUMENT IN ({{DAYS_MATURED_INSTRUMENTS}})
-- @@END step14a
     )
SELECT c.t, c.PK, c.PK - TRUNC(c.PK) AS fraction, f.fr AS expected
FROM   created c CROSS JOIN f
WHERE  c.PK - TRUNC(c.PK) <> f.fr
UNION ALL   -- the auth code must be exactly one row, or the comparison above proves nothing
SELECT 'GOM_GLB_SYS.T__CORE_INFO_S rows (must be 1)', COUNT(*), NULL, NULL FROM gom_glb_sys.t__CORE_INFO_S
HAVING COUNT(*) <> 1;

-- V2 - ROW COUNTS per step: only the steps whose count differs are listed.   Expect: 0 rows.
WITH conf  AS (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S   WHERE DESCRIPTION = {{CONF_DESCRIPTION_SQL}}),
     curve AS (SELECT PK FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = {{CURVE_DESCRIPTION_SQL}})
SELECT * FROM (
SELECT '2' step, (SELECT COUNT(*) FROM conf) n, 1 expected FROM dual
UNION ALL SELECT '3', (SELECT COUNT(*) FROM curve), 1 FROM dual
UNION ALL SELECT '4', (SELECT COUNT(*) FROM BOX_FE.T_BOX_ENGLKFC_X WHERE FK_PARENT IN (SELECT PK FROM curve)), {{EXPECTED_QUOTE_REFS}} FROM dual
UNION ALL SELECT '5', (SELECT COUNT(*) FROM BOX_FE.T_BOX_ENGCONF_X WHERE FK_PARENT IN (SELECT PK FROM conf)), 1 FROM dual
UNION ALL SELECT '6', (SELECT COUNT(*) FROM BOX_FE.T_BOX_ENGACCRCONF_S WHERE FK_PARENT IN (SELECT PK FROM conf)), {{N_STEP6}} FROM dual
UNION ALL SELECT '7', (SELECT COUNT(*) FROM BOX_FE.T_BOX_CONFIG_ACCRUAL_S WHERE FK_PARENT IN (SELECT PK FROM conf)), {{EXPECTED_EXCEPTIONS}} FROM dual
UNION ALL SELECT '8', (SELECT COUNT(*) FROM BOX_FE.T_BOX_FIXING_BY_INSTR_S WHERE FK_PARENT IN (SELECT PK FROM conf)), 0 FROM dual
UNION ALL SELECT '11', (SELECT COUNT(*) FROM BOX_FE.T_BOX_CONF_BY_BOOK_S WHERE FK_PARENT IN (SELECT PK FROM conf)), {{N_STEP11}} FROM dual
UNION ALL SELECT '12', (SELECT COUNT(*) FROM BOX_FE.T_BOX_ERRORS_FE_S WHERE FK_BRANCH = {{BRANCH_PK}}), {{N_STEP12}} FROM dual
-- @@BEGIN step14a
UNION ALL SELECT '14a', (SELECT COUNT(*) FROM BOX_FE.T_BOX_ENGDAYS_MATURED_S WHERE FK_INSTRUMENT IN ({{DAYS_MATURED_INSTRUMENTS}})), {{N_STEP14A}} FROM dual
-- @@END step14a
UNION ALL SELECT 'branch', (SELECT COUNT(*) FROM BOX_FE.T_BOX_ENGCONF_X WHERE FK_BS = {{BRANCH_PK}}), 1 FROM dual
) WHERE n <> expected;

-- V3 - the header: this run's curve on both curve columns, BOX's sources, the mined values.
-- Expect: 1 row.
SELECT h.PK, h.FK_CURVEMAN, h.FK_CURVEACC, h.FK_SOURCE_FRONT, h.FK_SOURCE_BACK, h.FK_CALENDAR, h.FK_CURRENCY
FROM   BOX_FE.T_BOX_ENGCONF_S h
JOIN   BOX_FE.T_BOX_ENGFCURVE_S c ON c.PK = h.FK_CURVEMAN
WHERE  h.DESCRIPTION = {{CONF_DESCRIPTION_SQL}}
AND    c.DESCRIPTION = {{CURVE_DESCRIPTION_SQL}}
AND    h.FK_CURVEACC = h.FK_CURVEMAN
AND    h.FK_SOURCE_BACK  = 586.4
AND    h.FK_SOURCE_FRONT = {{SOURCE_FRONT}}
AND    h.FK_CALENDAR = {{FK_CALENDAR}}
AND    h.FK_CURRENCY = {{FK_CURRENCY}}
AND    c.FK_CURRENCY = {{CURVE_FK_CURRENCY}};

