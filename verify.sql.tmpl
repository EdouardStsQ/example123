-- ============================================================================
-- {{BRANCH_CODE}} — BOX FE configuration — {{TARGET_ENV}}                 VERIFY  (2 of 3)
-- Read-only. Run straight after the config script — by the OPERATOR's read-only account, which sees
-- BOX_FE, DEVENG, PGT_* and GOM_GLB_SYS. (The applying account sees only BOX_FE, so the comparisons
-- with GBO — V1's auth code, V4, V10 — live here, not in the config script.)
-- Every query states its expected result. Anything else is a failure: stop and report which.
-- Rows this run created are found by the header and curve DESCRIPTIONs (globally unique) — never by
-- a PK typed from the apply log.
-- ============================================================================
SET DEFINE OFF

-- V1 — AUTH CODE. Every row this run created carries this environment's auth-code fraction.
-- Expect: 0 rows.
WITH f     AS (SELECT auth_code / POWER(10, LENGTH(TO_CHAR(auth_code))) AS fr FROM gom_glb_sys.t__CORE_INFO_S),
     conf  AS (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S   WHERE DESCRIPTION = '{{CONF_DESCRIPTION}}'),
     curve AS (SELECT PK FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = '{{CURVE_DESCRIPTION}}'),
     created AS (
       SELECT 'T_BOX_ENGCONF_S'         t, PK FROM conf
       UNION ALL SELECT 'T_BOX_ENGFCURVE_S',       PK FROM curve
       UNION ALL SELECT 'T_BOX_ENGLKFC_X',         PK FROM BOX_FE.T_BOX_ENGLKFC_X        WHERE FK_PARENT IN (SELECT PK FROM curve)
       UNION ALL SELECT 'T_BOX_ENGCONF_X',         PK FROM BOX_FE.T_BOX_ENGCONF_X        WHERE FK_PARENT IN (SELECT PK FROM conf)
       UNION ALL SELECT 'T_BOX_ENGACCRCONF_S',     PK FROM BOX_FE.T_BOX_ENGACCRCONF_S    WHERE FK_PARENT IN (SELECT PK FROM conf)
       UNION ALL SELECT 'T_BOX_CONFIG_ACCRUAL_S',  PK FROM BOX_FE.T_BOX_CONFIG_ACCRUAL_S WHERE FK_PARENT IN (SELECT PK FROM conf)
       UNION ALL SELECT 'T_BOX_CONF_BY_BOOK_S',    PK FROM BOX_FE.T_BOX_CONF_BY_BOOK_S   WHERE FK_PARENT IN (SELECT PK FROM conf)
       UNION ALL SELECT 'T_BOX_ERRORS_FE_S',       PK FROM BOX_FE.T_BOX_ERRORS_FE_S      WHERE FK_BRANCH = {{BRANCH_PK}}
       UNION ALL SELECT 'T_BOX_ENGDAYS_MATURED_S', PK FROM BOX_FE.T_BOX_ENGDAYS_MATURED_S WHERE FK_INSTRUMENT IN ({{DAYS_MATURED_INSTRUMENTS}}))
SELECT c.t, c.PK, c.PK - TRUNC(c.PK) AS fraction, f.fr AS expected
FROM   created c CROSS JOIN f
WHERE  c.PK - TRUNC(c.PK) <> f.fr;

-- V2 — ROW COUNTS per step. Expect exactly the findings-table counts, shown in the right-hand column.
WITH conf  AS (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S   WHERE DESCRIPTION = '{{CONF_DESCRIPTION}}'),
     curve AS (SELECT PK FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = '{{CURVE_DESCRIPTION}}')
SELECT '2'   step, (SELECT COUNT(*) FROM conf) n, 1 expected FROM dual
UNION ALL SELECT '3',   (SELECT COUNT(*) FROM curve), 1 FROM dual
UNION ALL SELECT '4',   (SELECT COUNT(*) FROM BOX_FE.T_BOX_ENGLKFC_X        WHERE FK_PARENT IN (SELECT PK FROM curve)), {{EXPECTED_QUOTE_REFS}} FROM dual
UNION ALL SELECT '5',   (SELECT COUNT(*) FROM BOX_FE.T_BOX_ENGCONF_X        WHERE FK_PARENT IN (SELECT PK FROM conf)), 1 FROM dual
UNION ALL SELECT '6',   (SELECT COUNT(*) FROM BOX_FE.T_BOX_ENGACCRCONF_S    WHERE FK_PARENT IN (SELECT PK FROM conf)), {{N_INSTRUMENTS}} FROM dual
UNION ALL SELECT '7',   (SELECT COUNT(*) FROM BOX_FE.T_BOX_CONFIG_ACCRUAL_S WHERE FK_PARENT IN (SELECT PK FROM conf)), {{EXPECTED_EXCEPTIONS}} FROM dual
UNION ALL SELECT '8',   (SELECT COUNT(*) FROM BOX_FE.T_BOX_FIXING_BY_INSTR_S WHERE FK_PARENT IN (SELECT PK FROM conf)), {{N_STEP8}} FROM dual
UNION ALL SELECT '11',  (SELECT COUNT(*) FROM BOX_FE.T_BOX_CONF_BY_BOOK_S   WHERE FK_PARENT IN (SELECT PK FROM conf)), {{N_BOOK_ROWS}} FROM dual
UNION ALL SELECT '12',  (SELECT COUNT(*) FROM BOX_FE.T_BOX_ERRORS_FE_S      WHERE FK_BRANCH = {{BRANCH_PK}}), {{N_INSTRUMENTS}} FROM dual
UNION ALL SELECT '14a', (SELECT COUNT(*) FROM BOX_FE.T_BOX_ENGDAYS_MATURED_S WHERE FK_INSTRUMENT IN ({{DAYS_MATURED_INSTRUMENTS}})), {{N_DAYS_MATURED}} FROM dual;

-- V3 — the header points at the curve this run created, and both sources are BOX's.   Expect: 1 row.
SELECT h.PK, h.FK_CURVEMAN, h.FK_CURVEACC, h.FK_SOURCE_FRONT, h.FK_SOURCE_BACK
FROM   BOX_FE.T_BOX_ENGCONF_S h
WHERE  h.DESCRIPTION = '{{CONF_DESCRIPTION}}'
AND    h.FK_CURVEMAN = (SELECT PK FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = '{{CURVE_DESCRIPTION}}')
AND    h.FK_CURVEACC = h.FK_CURVEMAN
AND    h.FK_SOURCE_BACK  = 586.4
AND    h.FK_SOURCE_FRONT = {{SOURCE_FRONT}};

-- V4 — the quote array equals NY's GBO array, both ways.   Expect: 0 rows, then 0 rows.
SELECT {{QUOTE_REF_COLUMN}} FROM DEVENG.T_PGT_ENGLKFC_X WHERE FK_PARENT = {{GBO_CURVE_PK}}
MINUS
SELECT FK_BS FROM BOX_FE.T_BOX_ENGLKFC_X
WHERE  FK_PARENT = (SELECT PK FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = '{{CURVE_DESCRIPTION}}');

SELECT FK_BS FROM BOX_FE.T_BOX_ENGLKFC_X
WHERE  FK_PARENT = (SELECT PK FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = '{{CURVE_DESCRIPTION}}')
MINUS
SELECT {{QUOTE_REF_COLUMN}} FROM DEVENG.T_PGT_ENGLKFC_X WHERE FK_PARENT = {{GBO_CURVE_PK}};

-- V5 — every FK_BRANCH written is the branch itself, and a real one.   Expect: 0 rows.
SELECT 'T_BOX_CONFIG_ACCRUAL_S' t, a.PK, a.FK_BRANCH FROM BOX_FE.T_BOX_CONFIG_ACCRUAL_S a
WHERE  a.FK_PARENT = (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S WHERE DESCRIPTION = '{{CONF_DESCRIPTION}}')
AND   (a.FK_BRANCH <> {{BRANCH_PK}} OR a.FK_BRANCH NOT IN (SELECT PK FROM PGT_STC.T_PGT_BRANCH_S))
UNION ALL
SELECT 'T_BOX_CONF_BY_BOOK_S', b.PK, b.FK_BRANCH FROM BOX_FE.T_BOX_CONF_BY_BOOK_S b
WHERE  b.FK_PARENT = (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S WHERE DESCRIPTION = '{{CONF_DESCRIPTION}}')
AND    b.FK_BRANCH <> {{BRANCH_PK}};

-- V6 — every instrument written is approved.   Expect: 0 rows.
SELECT 'T_BOX_ENGACCRCONF_S' t, FK_INSTRUMENT FROM BOX_FE.T_BOX_ENGACCRCONF_S
WHERE  FK_PARENT = (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S WHERE DESCRIPTION = '{{CONF_DESCRIPTION}}')
AND    FK_INSTRUMENT NOT IN ({{APPROVED_INSTRUMENTS}})
UNION ALL
SELECT 'T_BOX_CONFIG_ACCRUAL_S', FK_INSTRUMENT FROM BOX_FE.T_BOX_CONFIG_ACCRUAL_S
WHERE  FK_PARENT = (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S WHERE DESCRIPTION = '{{CONF_DESCRIPTION}}')
AND    FK_INSTRUMENT NOT IN ({{APPROVED_INSTRUMENTS}})
UNION ALL
SELECT 'T_BOX_CONF_BY_BOOK_S', FK_INSTRUMENT FROM BOX_FE.T_BOX_CONF_BY_BOOK_S
WHERE  FK_BRANCH = {{BRANCH_PK}} AND FK_INSTRUMENT NOT IN ({{APPROVED_INSTRUMENTS}})
UNION ALL
SELECT 'T_BOX_ERRORS_FE_S', FK_INSTRUMENT FROM BOX_FE.T_BOX_ERRORS_FE_S
WHERE  FK_BRANCH = {{BRANCH_PK}} AND FK_INSTRUMENT NOT IN ({{APPROVED_INSTRUMENTS}});

-- V7 — step 11: each approved instrument has every book row AND its dummy-book row.   Expect: 0 rows.
SELECT i.COLUMN_VALUE AS instrument, l.COLUMN_VALUE AS label
FROM   TABLE(sys.odcinumberlist({{APPROVED_INSTRUMENTS}})) i
CROSS  JOIN TABLE(sys.odcinumberlist({{BOOK_LABELS}}, {{DUMMY_BOOK_LABEL}})) l
WHERE  NOT EXISTS (SELECT 1 FROM BOX_FE.T_BOX_CONF_BY_BOOK_S b
                   WHERE b.FK_BRANCH = {{BRANCH_PK}} AND b.FK_INSTRUMENT = i.COLUMN_VALUE
                   AND   b.FK_LABEL  = l.COLUMN_VALUE);

-- V8 — step 14a: every approved instrument now has a Days Matured row.   Expect: 0 rows.
SELECT i.COLUMN_VALUE AS instrument_without_days_matured
FROM   TABLE(sys.odcinumberlist({{APPROVED_INSTRUMENTS}})) i
WHERE  NOT EXISTS (SELECT 1 FROM BOX_FE.T_BOX_ENGDAYS_MATURED_S d WHERE d.FK_INSTRUMENT = i.COLUMN_VALUE);

-- V10 — step 7 = this branch's GBO exceptions for the approved instruments, both ways.   Expect: 0, then 0.
SELECT g.FK_INSTRUMENT, g.FK_STRATEGY, g.FK_INSTRTYPE, g.CRITERIAL
FROM   DEVENG.T_PGT_CONFIG_ACCRUAL_S g
JOIN   PGT_STC.T_PGT_BRANCH_CONFIG_S bc ON bc.PK = g.FK_BRANCH
WHERE  g.FK_PARENT = {{GBO_CONFIG_PK}} AND bc.FK_BRANCH = {{BRANCH_PK}}
AND    g.FK_INSTRUMENT IN ({{APPROVED_INSTRUMENTS}})
MINUS
SELECT FK_INSTRUMENT, FK_STRATEGY, FK_INSTRTYPE, CRITERIAL FROM BOX_FE.T_BOX_CONFIG_ACCRUAL_S
WHERE  FK_PARENT = (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S WHERE DESCRIPTION = '{{CONF_DESCRIPTION}}');

SELECT FK_INSTRUMENT, FK_STRATEGY, FK_INSTRTYPE, CRITERIAL FROM BOX_FE.T_BOX_CONFIG_ACCRUAL_S
WHERE  FK_PARENT = (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S WHERE DESCRIPTION = '{{CONF_DESCRIPTION}}')
MINUS
SELECT g.FK_INSTRUMENT, g.FK_STRATEGY, g.FK_INSTRTYPE, g.CRITERIAL
FROM   DEVENG.T_PGT_CONFIG_ACCRUAL_S g
JOIN   PGT_STC.T_PGT_BRANCH_CONFIG_S bc ON bc.PK = g.FK_BRANCH
WHERE  g.FK_PARENT = {{GBO_CONFIG_PK}} AND bc.FK_BRANCH = {{BRANCH_PK}}
AND    g.FK_INSTRUMENT IN ({{APPROVED_INSTRUMENTS}});

-- V9 — identity columns are the Q-G6 constants.   Expect: 0 rows.
SELECT 'T_BOX_ENGCONF_S' t, PK FROM BOX_FE.T_BOX_ENGCONF_S
WHERE  DESCRIPTION = '{{CONF_DESCRIPTION}}' AND (FK_OWNER_OBJ <> {{OWNER_ENGCONF}} OR FK_EXTENSION IS NOT NULL)
UNION ALL
SELECT 'T_BOX_ENGLKFC_X', PK FROM BOX_FE.T_BOX_ENGLKFC_X
WHERE  FK_PARENT = (SELECT PK FROM BOX_FE.T_BOX_ENGFCURVE_S WHERE DESCRIPTION = '{{CURVE_DESCRIPTION}}')
AND   (FK_OWNER_OBJ <> {{OWNER_ENGFCURVE}} OR FK_EXTENSION <> {{EXT_ENGLKFC}})
UNION ALL
SELECT 'T_BOX_ERRORS_FE_S', PK FROM BOX_FE.T_BOX_ERRORS_FE_S
WHERE  FK_BRANCH = {{BRANCH_PK}} AND FK_OWNER_OBJ <> {{OWNER_ERRORS_FE}};
