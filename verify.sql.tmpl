WHERE  x.FK_PARENT = (SELECT PK FROM BOX_FE.T_BOX_ENGCONF_S WHERE DESCRIPTION = {{CONF_DESCRIPTION_SQL}})
AND   (x.FK_BS <> {{BRANCH_PK}} OR x.FK_BS NOT IN (SELECT PK FROM PGT_STC.T_PGT_BRANCH_S))
-- @@BEGIN step7
UNION ALL
